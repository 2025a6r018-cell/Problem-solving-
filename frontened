            st.markdown(
                '<div class="auth-card-title">Create your account</div>'
                '<div class="auth-card-subtitle">Your name and a private PIN are all you need.</div>',
                unsafe_allow_html=True,
            )
            with st.form("profile_create_form"):
                profile_name = st.text_input("Name", max_chars=32)
                birth_date = st.date_input(
                    "Date of birth",
                    value=None,
                    min_value=date(1900, 1, 1),
                    max_value=date.today(),
                    format="YYYY-MM-DD",
                )
                new_pin = st.text_input("PIN (4–12 digits)", type="password", max_chars=12)
                confirm_pin = st.text_input("Confirm PIN", type="password", max_chars=12)
                create_account = st.form_submit_button(
                    "Create account", type="primary", use_container_width=True
                )
            if create_account:
                if not profile_name.strip():
                    st.error("Enter your name.")
                elif birth_date is None:
                    st.error("Choose your date of birth.")
                elif not new_pin.isdigit() or not 4 <= len(new_pin) <= 12:
                    st.error("Your PIN must contain 4–12 digits.")
                elif new_pin != confirm_pin:
                    st.error("The PINs do not match.")
                else:
                    try:
                        sign_in(
                            api_request(
                                "POST",
                                "/profiles/create",
                                payload={
                                    "username": profile_name.strip(),
                                    "display_name": profile_name.strip(),
                                    "date_of_birth": birth_date.isoformat(),
                                    "pin": new_pin,
                                },
                            )
                        )
                        st.rerun()
                    except APIError as error:
                        api_error_message(error)
