    "unclear": {"background": "#f3f6f2", "accent": "#176b63", "sidebar": "#eaf1ed"},
}


class APIError(Exception):
    def __init__(self, message, status_code=None):
        super().__init__(message)
        self.status_code = status_code


def api_request(method, path, token=None, payload=None):
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    try:
        response = requests.request(
            method,
            f"{API_URL}{path}",
            headers=headers,
            json=payload,
            timeout=10,
        )
    except requests.RequestException as error:
        raise APIError("Backend is unavailable. Start it in another terminal.") from error

    try:
        data = response.json()
    except ValueError:
        data = {}
    if not response.ok:
        raise APIError(data.get("detail", "The request failed."), response.status_code)
    return data


def save_auth(data):
    st.session_state.access_token = data["access_token"]
    st.session_state.username = data["username"]
    st.session_state.last_prediction = None
    st.session_state.game_question = None
    st.session_state.game_feedback = None


def render_emotion_chart(records):
    counts = pd.Series(
        [record["emotion"] for record in records], dtype="string"
    ).value_counts()
    chart_counts = counts.reindex(EMOTIONS, fill_value=0)
    max_count = max(chart_counts.max(), 1)
    rows = []
    for emotion, count in chart_counts.items():
        theme = EMOTION_THEMES[emotion]
        width = count / max_count * 100
        rows.append(
            f"""
            <div class="emotion-row">
                <div class="emotion-label">{EMOJIS[emotion]} {emotion.title()}</div>
                <div class="emotion-track">
                    <div class="emotion-bar" style="width:{width:.1f}%;background:{theme['accent']}"></div>
                </div>
                <div class="emotion-count">{count}</div>
            </div>
            """
        )
    st.markdown(
        '<div class="emotion-chart">' + "".join(rows) + "</div>",
        unsafe_allow_html=True,
    )


