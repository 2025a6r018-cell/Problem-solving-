st.caption("Your saved analyses are private to your account on this app instance. Avoid sensitive text.")
with st.expander("About the results"):
    st.write("EmoTech estimates six emotions: joy, sadness, anger, fear, love, and surprise.")
    st.write("Scores are estimates, not a definite reading of someone's feelings.")

dashboard_tab, detect_tab, history_tab, game_tab = st.tabs(
    ["📊 Dashboard", "🔍 Analyze", "🗂 History", "🎮 Emotion game"]
)

with dashboard_tab:
    st.subheader("Your dashboard")
    st.write("A quick overview of your saved emotion analyses.")
    try:
        dashboard_records = api_request(
            "GET", "/history", token=st.session_state.access_token
        )
        if dashboard_records:
            emotion_counts = pd.Series(
                [record["emotion"].title() for record in dashboard_records]
            ).value_counts()
            top_emotion = emotion_counts.index[0] if not emotion_counts.empty else "—"
            metric_cols = st.columns(3)
            metric_cols[0].metric("Total analyses", len(dashboard_records))
            metric_cols[1].metric("Emotions detected", len(emotion_counts))
            metric_cols[2].metric("Most common", top_emotion)
            chart_col, activity_col = st.columns([1.2, 1])
            with chart_col:
                st.markdown("#### Emotion distribution")
                render_emotion_chart(dashboard_records)
            with activity_col:
                st.markdown("#### Recent activity")
                for record in dashboard_records[:5]:
                    st.markdown(
                        f"**{EMOJIS.get(record['emotion'], '🎭')} "
                        f"{record['emotion'].title()}** · {record['created_at']}"
                    )
                    preview = record["text"][:120]
                    st.caption(preview + ("…" if len(record["text"]) > 120 else ""))
                    st.divider()
        else:
            st.info("No analyses yet. Open **Analyze** to get started.")
    except APIError as error:
        st.error(str(error))

with detect_tab:
    st.subheader("Analyze text")
    with st.form("prediction_form"):
        text = st.text_area(
            "Enter a sentence",
            placeholder="Example: I am excited about my new project!",
            max_chars=5000,
            height=120,
        )
        submitted = st.form_submit_button("Detect emotion", type="primary")
    if submitted:
        if not text.strip():
            st.warning("Enter a sentence first.")
        else:
            try:
                st.session_state.last_prediction = api_request(
                    "POST",
                    "/predict",
                    token=st.session_state.access_token,
                    payload={"text": text.strip()},
                )
                st.rerun()
            except APIError as error:
                st.error(str(error))
    result = st.session_state.last_prediction
    if result:
        emotion = result["emotion"]
        st.markdown(f"## {EMOJIS.get(emotion, '🎭')} {emotion.title()}")
        st.write("**Analyzed text:**", result["text"])
        st.subheader("Scores for every emotion")
        for label, score in sorted(
            result["scores"].items(), key=lambda item: item[1], reverse=True
        ):
            st.progress(
                min(max(score / 100, 0), 1),
                text=f"{EMOJIS.get(label, '')} {label.title()}: {score:.2f}%",
            )
        st.caption(
            "Model scores are estimates and may not be calibrated probabilities "
            "of a person's actual emotion."
        )

with history_tab:
    st.subheader("Prediction history")
    try:
        records = api_request("GET", "/history", token=st.session_state.access_token)
        if records:
            rows = [
                {
                    "Time": record["created_at"],
                    "Text": record["text"],
                    "Emotion": record["emotion"].title(),
                    **{
                        f"{label.title()} (%)": f"{score:.2f}%"
                        for label, score in record["scores"].items()
                    },
                }
                for record in records
            ]
            history = pd.DataFrame(rows)
            first, second = st.columns(2)
            first.metric("Predictions", len(history))
            second.metric("Different emotions", history["Emotion"].nunique())
            st.dataframe(history, use_container_width=True, hide_index=True)
            st.subheader("Emotion distribution")
            render_emotion_chart(records)
            st.download_button(
                "Download history as CSV",
                history.to_csv(index=False).encode("utf-8"),
                "emotion_history.csv",
                "text/csv",
            )
            if st.button("Clear my history"):
                api_request("DELETE", "/history", token=st.session_state.access_token)
                st.rerun()
        else:
            st.info("Your saved predictions will appear here.")
    except APIError as error:
        st.error(str(error))

with game_tab:
    st.subheader("Guess the emotion")
    if st.session_state.game_question is None:
        try:
            st.session_state.game_question = api_request(
                "POST", "/game/next", token=st.session_state.access_token
            )
        except APIError as error:
            st.error(str(error))
    question = st.session_state.game_question
    if question:
        st.info(question["text"])
        guess = st.selectbox(
            "Which emotion fits this sentence?",
            question["labels"],
            format_func=lambda label: f"{EMOJIS.get(label, '')} {label.title()}",
        )
        check_col, next_col = st.columns(2)
        with check_col:
            if st.button("Check answer", use_container_width=True):
                try:
                    st.session_state.game_feedback = api_request(
                        "POST",
                        "/game/guess",
                        token=st.session_state.access_token,
                        payload={"game_id": question["game_id"], "guess": guess},
                    )
                except APIError as error:
                    st.error(str(error))
        with next_col:
            if st.button("Next sentence", use_container_width=True):
                try:
                    st.session_state.game_question = api_request(
                        "POST", "/game/next", token=st.session_state.access_token
                    )
                    st.session_state.game_feedback = None
                    st.rerun()
                except APIError as error:
                    st.error(str(error))
        feedback = st.session_state.game_feedback
        if feedback:
            if feedback["correct"]:
                st.success(
                    f"Correct! {EMOJIS.get(feedback['answer'], '')} "
                    f"{feedback['answer'].title()}"
                )
            else:
                st.error(
                    f"The answer was {feedback['answer'].title()} "
                    f"{EMOJIS.get(feedback['answer'], '')}"
                )
