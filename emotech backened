class Credentials(BaseModel):
    username: str = Field(min_length=3, max_length=32)
    password: str = Field(min_length=8, max_length=256)


class PredictionRequest(BaseModel):
    text: str = Field(min_length=1, max_length=5000)


class GuessRequest(BaseModel):
    game_id: str
    guess: str


@contextmanager
def db():
    connection = sqlite3.connect(DATABASE_PATH, timeout=10)
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA foreign_keys = ON")
    try:
        yield connection
        connection.commit()
    except Exception:
        connection.rollback()
        raise
    finally:
        connection.close()


def initialize_database():
    with db() as connection:
        connection.execute("CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT NOT NULL UNIQUE, password_hash TEXT NOT NULL, salt TEXT NOT NULL, created_at TEXT NOT NULL)")
        connection.execute("CREATE TABLE IF NOT EXISTS sessions (token_hash TEXT PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id), expires_at INTEGER NOT NULL)")
        connection.execute("CREATE TABLE IF NOT EXISTS predictions (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL REFERENCES users(id), created_at TEXT NOT NULL, text TEXT NOT NULL, emotion TEXT NOT NULL, scores_json TEXT NOT NULL)")
        columns = {row["name"] for row in connection.execute("PRAGMA table_info(predictions)")}
        if "user_id" not in columns:
            connection.execute("ALTER TABLE predictions ADD COLUMN user_id INTEGER REFERENCES users(id)")
        connection.execute("CREATE INDEX IF NOT EXISTS idx_predictions_user_id ON predictions(user_id, id DESC)")
        connection.execute("CREATE TABLE IF NOT EXISTS game_questions (game_id TEXT PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id), text TEXT NOT NULL, answer TEXT NOT NULL, is_answered INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL)")


def password_digest(password, salt):
    return hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), bytes.fromhex(salt), 250_000).hex()


def issue_token(user_id):
    token = secrets.token_urlsafe(32)
    digest = hashlib.sha256(token.encode("utf-8")).hexdigest()
    with db() as connection:
        connection.execute("INSERT INTO sessions VALUES (?, ?, ?)", (digest, user_id, int(time.time()) + TOKEN_LIFETIME_SECONDS))
    return token


def extract_token(authorization):
    if not authorization or not authorization.lower().startswith("bearer "):
        raise HTTPException(status_code=401, detail="Sign in to continue.")
    token = authorization[7:].strip()
    if not token:
        raise HTTPException(status_code=401, detail="Sign in to continue.")
    return token


def current_user(authorization: str | None = Header(default=None)):
    token = extract_token(authorization)
    digest = hashlib.sha256(token.encode("utf-8")).hexdigest()
    with db() as connection:
        row = connection.execute("SELECT users.id, users.username, sessions.expires_at FROM sessions JOIN users ON users.id = sessions.user_id WHERE sessions.token_hash = ?", (digest,)).fetchone()
        if row is not None and row["expires_at"] < int(time.time()):
            connection.execute("DELETE FROM sessions WHERE token_hash = ?", (digest,))
            row = None
    if row is None:
        raise HTTPException(status_code=401, detail="Session expired. Sign in again.")
    return {"id": row["id"], "username": row["username"]}


def load_training_data():
    if not DATA_CACHE_PATH.exists():
        response = requests.get(GOEMOTIONS_URL, timeout=90)
        response.raise_for_status()
        DATA_CACHE_PATH.write_bytes(response.content)

    texts = []
    targets = []
    with DATA_CACHE_PATH.open("r", encoding="utf-8", newline="") as data_file:
        for row in csv.reader(data_file, delimiter="\t"):
            if len(row) < 2:
                continue
            try:
                label_ids = {int(value) for value in row[1].split(",")}
            except ValueError:
                continue
            mapped = {
                GOEMOTIONS_TO_LABEL[GOEMOTIONS_LABELS[label_id]]
                for label_id in label_ids
                if 0 <= label_id < len(GOEMOTIONS_LABELS)
                and GOEMOTIONS_LABELS[label_id] in GOEMOTIONS_TO_LABEL
            }
            if len(mapped) == 1 and row[0].strip():
                texts.append(row[0])
                targets.append(mapped.pop())

    if not texts or set(targets) != set(LABELS):
        raise ValueError("The GoEmotions data did not contain usable examples for all six app emotions.")
    return texts, targets


@lru_cache(maxsize=1)
def load_emotion_model():
    import joblib
    from sklearn.feature_extraction.text import TfidfVectorizer
    from sklearn.linear_model import LogisticRegression
    from sklearn.pipeline import make_pipeline

    if MODEL_CACHE_PATH.exists():
        return joblib.load(MODEL_CACHE_PATH)

    texts, targets = load_training_data()
    model = make_pipeline(
        TfidfVectorizer(
            max_features=50_000,
            ngram_range=(1, 2),
            sublinear_tf=True,
            strip_accents="unicode",
            stop_words="english",
        ),
        LogisticRegression(
            max_iter=300,
            class_weight="balanced",
            random_state=42,
        ),
    )
    model.fit(texts, targets)
    joblib.dump(model, MODEL_CACHE_PATH)
    return model


def predict_emotions(text):
    try:
        model = load_emotion_model()
    except Exception as error:
        raise HTTPException(
            status_code=503,
            detail=f"The ML model could not load. Check scikit-learn, internet access, and Windows app-control permissions. ({error})",
        ) from error

    probabilities = model.predict_proba([text])[0]
    scores = {
        label: float(probability) * 100
        for label, probability in zip(model.classes_, probabilities)
    }
    emotion = max(scores, key=scores.get)
    return emotion, scores


