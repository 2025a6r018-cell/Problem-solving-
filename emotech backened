@app.post("/auth/register")
def register(payload: Credentials):
    username = payload.username.strip().lower()
    if not re.fullmatch(r"[a-z0-9_.-]{3,32}", username):
        raise HTTPException(status_code=422, detail="Use 3-32 letters, numbers, dots, dashes, or underscores.")
    salt = secrets.token_bytes(16).hex()
    try:
        with db() as connection:
            cursor = connection.execute("INSERT INTO users (username, password_hash, salt, created_at) VALUES (?, ?, ?, ?)", (username, password_digest(payload.password, salt), salt, datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
            user_id = cursor.lastrowid
    except sqlite3.IntegrityError:
        raise HTTPException(status_code=409, detail="That username is already in use.")
    return {"access_token": issue_token(user_id), "username": username}


@app.post("/auth/login")
def login(payload: Credentials):
    with db() as connection:
        row = connection.execute("SELECT id, username, password_hash, salt FROM users WHERE username = ?", (payload.username.strip().lower(),)).fetchone()
    if row is None or not hmac.compare_digest(password_digest(payload.password, row["salt"]), row["password_hash"]):
        raise HTTPException(status_code=401, detail="Username or password is incorrect.")
    return {"access_token": issue_token(row["id"]), "username": row["username"]}


@app.get("/auth/me")
def me(user=Depends(current_user)):
    return user


@app.post("/auth/logout")
def logout(authorization: str | None = Header(default=None), user=Depends(current_user)):
    digest = hashlib.sha256(extract_token(authorization).encode("utf-8")).hexdigest()
    with db() as connection:
        connection.execute("DELETE FROM sessions WHERE token_hash = ?", (digest,))
    return {"ok": True}


@app.post("/predict")
def analyze(payload: PredictionRequest, user=Depends(current_user)):
    text = payload.text.strip()
    if not text:
        raise HTTPException(status_code=422, detail="Enter text to analyze.")
    emotion, scores = predict_emotions(text)
    with db() as connection:
        connection.execute("INSERT INTO predictions (user_id, created_at, text, emotion, scores_json) VALUES (?, ?, ?, ?, ?)", (user["id"], datetime.now().strftime("%Y-%m-%d %H:%M:%S"), text, emotion, json.dumps(scores)))
    return {"text": text, "emotion": emotion, "scores": scores}


@app.get("/history")
def history(user=Depends(current_user)):
    with db() as connection:
        rows = connection.execute("SELECT id, created_at, text, emotion, scores_json FROM predictions WHERE user_id = ? ORDER BY id DESC", (user["id"],)).fetchall()
    return [{"id": row["id"], "created_at": row["created_at"], "text": row["text"], "emotion": row["emotion"], "scores": json.loads(row["scores_json"])} for row in rows]


@app.delete("/history")
def delete_history(user=Depends(current_user)):
    with db() as connection:
        connection.execute("DELETE FROM predictions WHERE user_id = ?", (user["id"],))
    return {"ok": True}


@app.post("/game/next")
def next_question(user=Depends(current_user)):
    answer = random.choice(LABELS)
    text = random.choice(GAME_EXAMPLES[answer])
    game_id = secrets.token_urlsafe(18)
    with db() as connection:
        connection.execute("DELETE FROM game_questions WHERE user_id = ? AND is_answered = 0", (user["id"],))
        connection.execute("INSERT INTO game_questions (game_id, user_id, text, answer, created_at) VALUES (?, ?, ?, ?, ?)", (game_id, user["id"], text, answer, datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
    return {"game_id": game_id, "text": text, "labels": LABELS}


@app.post("/game/guess")
def submit_guess(payload: GuessRequest, user=Depends(current_user)):
    if payload.guess not in LABELS:
        raise HTTPException(status_code=422, detail="Choose a listed emotion.")
    with db() as connection:
        row = connection.execute("SELECT answer, is_answered FROM game_questions WHERE game_id = ? AND user_id = ?", (payload.game_id, user["id"])).fetchone()
        if row is None:
            raise HTTPException(status_code=404, detail="Question not found. Start a new round.")
        if row["is_answered"]:
            raise HTTPException(status_code=409, detail="This question was already answered.")
        connection.execute("UPDATE game_questions SET is_answered = 1 WHERE game_id = ?", (payload.game_id,))
    return {"correct": payload.guess == row["answer"], "answer": row["answer"]}
