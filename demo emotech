if st.session_state.access_token is None:
    st.markdown(
        '<div class="brand-lockup"><div class="brand-mark">🎭</div><div>'
        '<h1 class="brand-name">EmoTech</h1>'
        '<p class="brand-tagline">Feel the meaning between the lines.</p>'
        "</div></div>",
        unsafe_allow_html=True,
    )
    st.caption("Sign in to analyze text and keep your personal prediction history.")
    login_tab, signup_tab = st.tabs(["Sign in", "Create account"])

    with login_tab:
        with st.form("login_form"):
            login_username = st.text_input("Username")
            login_password = st.text_input("Password", type="password")
            login_submitted = st.form_submit_button("Sign in", type="primary")
        if login_submitted:
            try:
                save_auth(
                    api_request(
                        "POST",
                        "/auth/login",
                        payload={"username": login_username, "password": login_password},
                    )
                )
                st.rerun()
            except APIError as error:
                st.error(str(error))

    with signup_tab:
        with st.form("signup_form"):
            signup_username = st.text_input("Choose a username (3-32 characters)")
            signup_password = st.text_input(
                "Choose a password (at least 8 characters)", type="password"
            )
            confirm_password = st.text_input("Confirm password", type="password")
            signup_submitted = st.form_submit_button("Create account", type="primary")
        if signup_submitted:
            if signup_password != confirm_password:
                st.error("The passwords do not match.")
            else:
                try:
                    save_auth(
                        api_request(
                            "POST",
                            "/auth/register",
                            payload={
                                "username": signup_username,
                                "password": signup_password,
                            },
                        )
                    )
                    st.rerun()
                except APIError as error:
                    st.error(str(error))
    st.stop()

try:
    user = api_request("GET", "/auth/me", token=st.session_state.access_token)
except APIError as error:
    st.session_state.access_token = None
    st.session_state.username = None
    st.session_state.last_prediction = None
    st.session_state.game_question = None
    st.session_state.game_feedback = None
    if error.status_code != 401:
        st.error(str(error))
    else:
        st.info("Your sign-in session expired. Please sign in again.")
    st.stop()

header_col, account_col = st.columns([5, 1])
with header_col:
    st.markdown(
        '<div class="brand-lockup"><div class="brand-mark">🎭</div><div>'
