    theme = EMOTION_THEMES.get(emotion, EMOTION_THEMES["neutral"])
    face_color = {
        "joy": "#f4d087",
        "sadness": "#b9d7ee",
        "anger": "#f3b39c",
        "fear": "#d7d0ef",
        "love": "#bfe3d7",
        "surprise": "#efc4db",
        "neutral": "#dfe7eb",
        "uncertain": "#e5d9b6",
    }.get(emotion, "#dfe7eb")
    eyes = {
        "joy": "◕ ◕",
        "sadness": "◡ ◡",
        "anger": "× ×",
        "fear": "• •",
        "love": "♥ ♥",
        "surprise": "◉ ◉",
        "neutral": "– –",
        "uncertain": "◌ ◌",
    }.get(emotion, "– –")
    mouth = {
        "joy": "◠",
        "sadness": "﹏",
        "anger": "╱╲",
